# Copie para .env e preencha só o que for usar.
# O .env não entra no Git.

# Análise de currículo. off = só o modo local, mesmo com --ai.
JOBSCOUT_AI_MODE=off
JOBSCOUT_AI_PROVIDER=
JOBSCOUT_AI_API_KEY=
JOBSCOUT_AI_MODEL=

# Fontes opcionais. Sem chave, a busca usa só as APIs públicas.
JOBSCOUT_ADZUNA_APP_ID=
JOBSCOUT_ADZUNA_APP_KEY=
JOBSCOUT_JOOBLE_API_KEY=

# Padrões da busca. JOBSCOUT_DATA_DIR vazio usa %USERPROFILE%\.jobscout
JOBSCOUT_COUNTRY=br
JOBSCOUT_SINCE_DAYS=14
JOBSCOUT_DATA_DIR=
