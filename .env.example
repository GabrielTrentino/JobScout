# Copie para .env e preencha só o que for usar.
# O .env não entra no Git.

# Onde ficam banco, perfil e token do Gmail. Vazio usa %USERPROFILE%\.jobscout
JOBSCOUT_DATA_DIR=

# Modelo por tarefa: off | ollama:<modelo> | gemini:<modelo>
# Sem nada, tudo roda por regras (zero custo, nada sai do computador).
JOBSCOUT_LLM_PADRAO=off
JOBSCOUT_LLM_CLASSIFICAR=
JOBSCOUT_LLM_RESUMIR=
JOBSCOUT_LLM_RESPONDER=
JOBSCOUT_LLM_PREPARAR=
JOBSCOUT_OLLAMA_URL=http://127.0.0.1:11434
JOBSCOUT_GEMINI_API_KEY=
# Classificar/resumir leem e-mails: só modelo local, a menos que mude para sim.
JOBSCOUT_LLM_NUVEM_PRIVADO=nao

# Gmail somente leitura. Cliente OAuth do tipo "App para computador" no Google Cloud.
JOBSCOUT_GMAIL_CLIENT_ID=
JOBSCOUT_GMAIL_CLIENT_SECRET=
JOBSCOUT_GMAIL_INTERVALO_MIN=5

# Vaga em aberto sem movimento por esse número de dias vira rascunho "Marcar como fria".
JOBSCOUT_DIAS_FRIA=14
