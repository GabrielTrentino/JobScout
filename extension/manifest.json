{
  "manifest_version": 3,
  "name": "JobScout",
  "version": "0.3.0",
  "description": "Registra vagas e candidaturas do LinkedIn e da InHire no JobScout deste computador. Tudo vira rascunho para você aprovar.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobScout",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/core.js", "content/page.js", "content/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.inhire.app/*", "https://*.inhire.com.br/*"],
      "js": ["content/core.js", "content/page.js", "content/inhire.js"],
      "run_at": "document_idle"
    }
  ]
}
